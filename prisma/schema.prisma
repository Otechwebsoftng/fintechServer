datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String   @db.VarChar(50)
  ipAddress     String   @db.VarChar(30)
  model         String?  @db.VarChar(60)
  userId        String?  @db.VarChar(36)
  body          Json?    @default("[]")
  route         Json?    @default("[]")
  query         Json?    @default("[]")
  requestStatus String
  response      Json?    @default("[]")
  createdAt     DateTime @default(now())
}

model User {
  id                         String                     @id @default(uuid())
  firstName                  String
  lastName                   String
  otherName                  String?
  userTag                    String?                    @unique
  email                      String                     @unique
  phoneNumber                String?                    @unique
  password                   String
  transactionPin             String?
  gender                     Gender                     @default(NOT_SPECIFIED)
  dob                        DateTime?
  otp                        String?
  otpType                    OtpType?
  otpExpiresIn               DateTime?
  userType                   UserType                   @default(USER)
  kycLevel                   KycLevel                   @default(LEVEL_0)
  bvn                        String?                    @unique
  bvnVerified                DocumentVerificationStatus @default(NOT_VERIFIED)
  identityType               IdentityType?
  identityTypeNo             String?
  identityTypeUrl            String?
  identityTypePublicId       String?
  identityVerificationStatus DocumentVerificationStatus @default(NOT_VERIFIED)
  status                     AccountStatus              @default(INACTIVE)
  isEmailVerified            Boolean                    @default(false)
  isAdminPasswordChanged     Boolean?                   @default(false)
  isDeleted                  Boolean                    @default(false)
  avatarUrl                  String?
  avatarPublicId             String?
  RefreshToken               RefreshToken[]
  role                       Role?                      @relation(fields: [roleId], references: [id])
  roleId                     String?
  ipAddress                  String?                    @db.VarChar(30)
  creatorId                  String?
  createdBy                  User?                      @relation("UserCreatedBy", fields: [creatorId], references: [id])
  updaterId                  String?
  lastUpdatedBy              User?                      @relation("UserLastUpdatedBy", fields: [updaterId], references: [id])
  payments                   Payment[]
  wallets                    Wallet[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  BlackListedIp              BlackListedIp[]
  createdUsers               User[]                     @relation("UserCreatedBy")
  updatedUsers               User[]                     @relation("UserLastUpdatedBy")
  beneficiaries              Beneficiary[]
  taxAddress                 TaxAddress?

  @@index([email, phoneNumber])
}

model TaxAddress {
  id                    String   @id @default(uuid())
  userId                String   @unique
  country               String?  @db.VarChar(50)
  state                 String?  @db.VarChar(50)
  city                  String?  @db.VarChar(50)
  street                String?  @db.VarChar(255)
  houseNo               String?  @db.VarChar(50)
  zipCode               String?  @db.VarChar(20)
  nationality           String?  @db.VarChar(50)
  taxCountry            String?  @db.VarChar(50)
  taxNumber             String?  @db.VarChar(100)
  isTaxAddressCompleted Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(50)
  slug        String           @unique @db.VarChar(60)
  description String?          @db.VarChar(256)
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String    @id @default(uuid())
  slug        String    @unique @db.VarChar(60)
  description String    @db.VarChar(160)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  roles          RolePermission[]
  MenuPermission MenuPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
}

model MenuPermission {
  menuItemId   String
  permissionId String
  createdAt    DateTime   @default(now())
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([menuItemId, permissionId])
}

model MenuItem {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  url         String           @db.VarChar(255)
  icon        String?          @db.VarChar(50)
  order       Int              @default(0)
  parentId    String?
  parent      MenuItem?        @relation("ChildMenuItems", fields: [parentId], references: [id])
  children    MenuItem[]       @relation("ChildMenuItems")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt
  permissions MenuPermission[]
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index(fields: [userId])
}

model Payment {
  id                String              @id @default(uuid())
  userId            String?
  status            PaymentStatus       @default(PENDING)
  currency          Currency            @default(NGN)
  description       String?
  reference         String?             @unique
  merchant_order_id String?             @db.VarChar(64)
  request_id        String?             @unique @db.VarChar(64)
  amount            Float?
  paymentEntry      PaymentEntry?       @default(CREDIT)
  paymentMethod     PaymentMethod       @default(CARD)
  ip_address        String?
  paid_at           DateTime?
  failed_at         DateTime?
  failure_reason    String?
  failure_code      String?
  metadata          Json?
  user              User?               @relation(fields: [userId], references: [id])
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?
  walletTransaction WalletTransaction[]

  @@index([userId, reference, request_id])
}

model Wallet {
  id                String              @id @default(uuid())
  userId            String
  currency          Currency
  accountType       WalletType?         @default(INDIVIDUAL)
  status            WalletStatus        @default(PENDING)
  merchantReference String?             @db.VarChar(64)
  bankName          String?             @db.VarChar(100)
  accountNumber     String?             @unique
  channelReference  String?             @db.VarChar(64)
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  webhooks          Webhook[]
  user              User                @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]

  @@unique([userId, currency], name: "user_currency_unique")
  @@index([userId, currency])
}

model WalletTransaction {
  id              String       @id @default(uuid())
  walletId        String
  amount          Float
  currency        Currency
  transactionType PaymentEntry
  reference       String?
  description     String?
  metadata        Json?
  paymentId       String?
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  wallet          Wallet       @relation(fields: [walletId], references: [id])
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([walletId])
  @@index([reference])
}

model Webhook {
  id               String    @id @default(uuid())
  domain           String?
  status           String?
  reference        String?
  amount           Float?
  message          String?
  gateway_response String?
  paid_at          DateTime?
  failed_at        DateTime?
  channel          String?
  currency         String?
  ip_address       String?
  metadata         Json?
  log              Json?
  fees             Float?
  customer         Json?
  authorization    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?
  wallet           Wallet?   @relation(fields: [walletId], references: [id])
  walletId         String?

  @@index([id, reference])
}

model Beneficiary {
  id            String   @id @default(uuid())
  userId        String
  country       String   @db.VarChar(50)
  bankName      String   @db.VarChar(100)
  accountNumber Int
  accountName   String   @db.VarChar(100)
  bankCode      String   @db.VarChar(10)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, accountNumber])
}

model BlackListedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique @db.VarChar(30)
  reason    String?  @db.VarChar(256)
  createdAt DateTime @default(now())
  userId    String?
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

enum DocumentVerificationStatus {
  PASSED
  FAILED
  NOT_VERIFIED
}

enum KycLevel {
  LEVEL_0 @map("LEVEL 0")
  LEVEL_1 @map("LEVEL 1")
  LEVEL_2 @map("LEVEL 2")
  LEVEL_3 @map("LEVEL 3")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  FLAGGED
  SUSPENDED
}

enum WalletStatus {
  APPROVED
  PENDING
  REJECTED
}

enum Currency {
  USD
  EUR
  GBP
  NGN
  CAD
}

enum IdentityType {
  NIN
  PASSPORT
  DRIVER_LICENSE
  NATIONAL_ID
}

enum UserType {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentEntry {
  CREDIT
  DEBIT
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum WalletType {
  INDIVIDUAL
  COOPERATE
}

enum OtpType {
  SIGN_UP
  CHANGE_PASSWORD
  FORGOT_PASSWORD
  ADMIN_LOGIN
}
